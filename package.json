        "express": "5.2.1",
        "express-rate-limit": "8.7.0",
        "express-session": "1.19.0",
        "helmet": "8.3.0",
        "mongodb": "~7.6.0",
        "mongoose": "^9.10.2",
        "node-cache": "^5.1.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript": "^7.0.2"
