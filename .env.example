# Copy to .env and fill in. Optional values can be left empty (or set to 'none').
# Startup stops with a clear error if a required value is missing or an ID isn't a Discord ID.

# --- Required ---

# MongoDB connection string
MONGO_URI=''

# Developer mode: 'true' uses the *_DEV token and application ID below and registers
# all commands to DEV_GUILD_ID only. Anything else (or empty) runs in production.
DEVELOPER_MODE='false'

# Production bot (required when DEVELOPER_MODE is not 'true')
BOT_TOKEN=''
BOT_APPLICATION_ID=''

# Development bot (required when DEVELOPER_MODE is 'true')
BOT_TOKEN_DEV=''
BOT_APPLICATION_ID_DEV=''

# --- Optional ---

# Default language (i18n locale code). Defaults to en-GB.
DEFAULT_LANGUAGE='en-GB'

# Developer guild: developer-only commands are registered here, and dev logs are sent here.
# Without it, developer-only commands are registered globally and dev logs are skipped.
DEV_GUILD_ID=''

# Comma-separated Discord user IDs allowed to use developer-only commands
DEVELOPER_IDS=''

# Dev log channels in DEV_GUILD_ID. Leave any empty to turn that log off.
COMMAND_CID=''
JOIN_GUILD_CID=''
LEAVE_GUILD_CID=''
USER_LEVEL_CID=''
VOTE_CID=''
# Errors from commands, events, dashboard actions and crashes, with the stack trace. Repeats are grouped.
ERROR_CID=''

# --- Dashboard (optional) ---
# Off unless DASHBOARD_ENABLED is 'true'. When on, it runs alongside the bot in the same process.
DASHBOARD_ENABLED='false'

# Where people open the dashboard. Must be https:// unless it's localhost.
# Add "<DASHBOARD_URL>/auth/callback" as a redirect in the Discord Developer Portal (OAuth2 page).
DASHBOARD_URL='http://localhost:3000'
DASHBOARD_PORT='3000'

# Which network interface to listen on. 127.0.0.1 = this machine only (recommended, also when
# behind a reverse proxy on the same machine). Only change it if you know you need to.
DASHBOARD_HOST='127.0.0.1'

# 'true' only when running behind a reverse proxy (nginx, Caddy) that handles HTTPS
DASHBOARD_TRUST_PROXY='false'

# OAuth2 client secret from the Developer Portal (OAuth2 page) for each bot. Keep these private.
BOT_CLIENT_SECRET=''
BOT_CLIENT_SECRET_DEV=''

# Signs login cookies. At least 32 random characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
SESSION_SECRET=''

# ---------- Stream notifications ----------
# Each platform is off until its keys are set. Keep these private.

# Twitch: create an application at https://dev.twitch.tv/console (any OAuth redirect, e.g. http://localhost)
TWITCH_CLIENT_ID=''
TWITCH_CLIENT_SECRET=''

# Kick: create an app at https://kick.com/settings/developer
KICK_CLIENT_ID=''
KICK_CLIENT_SECRET=''

# YouTube: new videos work without a key. Live streams need a YouTube Data API v3 key from
# https://console.cloud.google.com (APIs & Services → Credentials → API key). Free quota is plenty.
YOUTUBE_API_KEY=''

# --- Translation (optional) ---
# /translate and the Translate message menu. A Google Cloud Translation API key from
# https://console.cloud.google.com (enable "Cloud Translation API", then APIs & Services → Credentials).
# The first 500,000 characters a month are free: set a quota cap so it can't go over.
GOOGLE_TRANSLATE_API_KEY=''

# --- Top.gg votes (optional) ---
# Gives giveaway bonus entries to people who voted for Ovx. Needs the dashboard running.
# On top.gg → your bot → Webhooks, set the URL to <DASHBOARD_URL>/webhooks/topgg and put the
# webhook secret Top.gg shows (starts with whs_) here. Older Top.gg webhooks, where you choose an
# "Authorization" yourself, work too: put that value here instead.
TOPGG_WEBHOOK_SECRET=''

# Posts Ovx's server count to its Top.gg page every 30 minutes. The token is on top.gg → your bot →
# Edit → Webhooks ("Token"). Not used in developer mode.
TOPGG_TOKEN=''

# --- Backups ---
# The whole database is backed up once a day (login sessions are left out). On by default, except in
# developer mode. Backups contain every server's data, so keep the folder and channel private.
# BACKUP_CID: a private channel (only you can see it) that each backup is also uploaded to, so a copy
# survives if this machine is lost. Leave empty to only keep them in BACKUP_DIR.
BACKUP_CID=''
BACKUPS_ENABLED=''
BACKUP_DIR='backups'
BACKUP_KEEP='14'
BACKUP_HOUR='4'
