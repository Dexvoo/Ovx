{
    "compilerOptions": {
        "checkJs": true,
        "strict": false,
        "noEmit": true,
        "target": "es2024",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "maxNodeModuleJsDepth": 0,
        "types": ["node"]
    },
    "include": ["src/**/*.js", "src/**/*.d.ts"]
}
